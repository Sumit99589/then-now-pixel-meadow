# ==============================================================================
# API Keys (Required for live mode. Never commit .env)
# ==============================================================================

# OpenAI API Key (https://platform.openai.com/api-keys)
# Powers the query planner, answer synthesis, and entailment verification models.
OPENAI_API_KEY=

# Tavily Search API Key (https://app.tavily.com)
# Powers current web search grounding and evidence collection.
TAVILY_API_KEY=

# ==============================================================================
# Model Configuration (Documented snapshots; configurable)
# ==============================================================================
PLANNER_MODEL=gpt-5.4-mini-2026-03-17
ANSWER_MODEL=gpt-5.4-2026-03-05
VERIFY_MODEL=gpt-5.4-mini-2026-03-17

# ==============================================================================
# Server & Environment Settings
# ==============================================================================
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/agent.sqlite
DEFAULT_TIMEZONE=Asia/Kolkata

# Security & Reverse Proxy
# APP_PASSWORD is required when binding to non-localhost (e.g. 0.0.0.0) for HTTP Basic auth.
APP_PASSWORD=
# Set to the exact browser origin behind a reverse proxy, e.g. https://agent.example.com
PUBLIC_ORIGIN=

# Turn timeout limit in milliseconds (1000 to 180000)
TURN_TIMEOUT_MS=90000

# ==============================================================================
# Offline Fixture / Demo Mode
# ==============================================================================
# Set to true to run offline synthetic fixtures with mock CRM data and zero API keys needed.
DEMO_MODE=false
