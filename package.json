{
  "name": "tracy",
  "version": "1.1.0",
  "private": true,
  "description": "Tracy: A provenance-first web-search chat agent in an animated, hand-drawn pixel-art research meadow.",
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23 || >=24"
  },
  "scripts": {
    "dev": "node --import=tsx --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --import=tsx --env-file-if-exists=.env src/server.ts",
    "demo": "node --import=tsx scripts/demo.ts",
    "test": "node --import=tsx --test tests/*.test.ts",
    "test:coverage": "node --import=tsx --experimental-test-coverage --test tests/*.test.ts",
    "eval": "node --import=tsx evals/run.ts",
    "eval:live": "node --import=tsx --env-file-if-exists=.env evals/live.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run check:ui && npm test && npm run eval",
    "check:ui": "node --check public/app.js && node --check public/meadow.js && node --check public/pixel-art.js"
  },
  "devDependencies": {
    "@types/node": "24.0.4",
    "tsx": "^4.23.15",
    "typescript": "5.8.3"
  },
  "license": "MIT"
}
